#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Key positions follow binding order in each layer (0 = Q, 1 = W, ... 37 = ESC).

/ {
    behaviors {
        // Plain mod-tap: hold only after tapping-term-ms with no other decision path.
        // No positional hold — that caused early mods on rolls with balanced/tap-preferred mix.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
           	&kp Q		&kp W		&kp E     	&kp R  		&kp T    	&kp Y   	&kp U           &kp I          &kp O    	&kp P
        	&kp A		&hml LALT S  	&hml LCTRL D   	&hml LSHFT F  	&kp G    	&kp H   	&hmr RSHFT J    &hmr RCTRL K   &hmr RALT L 	&kp SEMI
&kp TAB		&kp Z		&kp X		&kp C     	&kp V  		&kp B    	&kp N   	&kp M           &kp COMMA      &kp DOT  	&kp FSLH  	&kp BSPC
                         			&kp LGUI  	&mo 1  		&kp SPACE    	&kp RET		&mo 2		&kp ESC
            >;
        };

        nav_num {
            bindings = <
                &kp N1		&kp N2		&kp N3		&kp N4		&kp N5       	&kp N6      	&kp N7          &kp N8      	&kp N9		&kp N0
                &trans		&trans      	&trans   	&trans		&trans		&kp LEFT	&kp DOWN	&kp UP		&kp RIGHT	&kp APOS
&kp CAPS	&trans		&trans		&trans		&trans		&trans		&trans		&trans		&trans		&trans		&trans		&kp DEL
                                        	&trans     	&trans          &trans          &trans   	&trans 		&trans
            >;
        };

        sym_func {
            bindings = <
                &kp LS(N1)	&kp LS(N2)	&kp LS(N3)	&kp LS(N4)	&kp LS(N5)	&kp LS(N6)	&kp LS(N7)	&kp LS(N8)	&kp LS(N9)	&kp LS(N0)
           	&trans	 	&trans          &kp PG_UP	&trans		&trans		&kp MINUS   	&kp EQUAL       &kp LBRC   	&kp RBRC   	&kp BSLH
&trans  	&trans		&kp HOME	&kp PG_DN	&kp END		&trans		&kp LS(MINUS) 	&kp LS(EQUAL)   &kp LS(LBRC)  	&kp LS(RBRC)  	&trans  	&trans
                                                &trans		&trans           &trans          &trans		&trans		&kp GRAVE
            >;
        };

        device {
            bindings = <
                &kp F1       	&kp F2                  &kp F3              	&kp F4            &kp F5       &kp F6       &kp F7          	&kp F8         &kp F9       &kp F10
                &none        	&kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC 	&none             &none        &bt BT_SEL 0 &bt BT_SEL 1  	&bt BT_SEL 2   &bt BT_SEL 3 &bt BT_SEL 4
&none		&kp K_MUTE  	&kp C_VOLUME_DOWN       &kp C_VOLUME_UP     	&kp C_PLAY_PAUSE  &none        &none        &none          	&none          &none        &none                &bt BT_CLR
                                                	&none               	&none             &none        &none        &none           	&none
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
